{
  "name": "ssmemo2",
  "version": "0.1.0",
  "private": true,
  "description": "Single-file HTML5 memo app (TypeScript + CodeMirror 6) that runs on air-gapped networks",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "build": "node scripts/build.ts",
    "gen:bat": "node scripts/makeBuildBat.ts",
    "test:build": "node --test \"test/build/**/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build && npm run test:build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~6.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  }
}
